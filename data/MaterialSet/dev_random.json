[{"data_id": 200, "text": "While NbTaTiV is very ductile and does not fracture up to 50% strain, NbTaTiVW has a yield strength of 1420 MPa with a fracture strain of 20%.", "set": [{"M": "NbTaTiVW", "F": "yield strength", "VoF": "1420 MPa", "C": "", "VoC": ""}, {"M": "NbTaTiVW", "F": "fracture strain", "VoF": "20%", "C": "", "VoC": ""}], "pred_set": [{"M": "NbTaTiVW", "F": "yield strength", "VoF": "1420 MPa", "C": "", "VoC": ""}, {"M": "NbTaTiVW", "F": "fracture strain", "VoF": "20%", "C": "", "VoC": ""}]}, {"data_id": 64, "text": "The fatigue limit of Ti\u201329Nb\u201313Ta\u20134.6Zr aged at 673 K for 259.2 ks after ST at 1063 K for 3.6 ks is the greatest (700 MPa) among other aged alloys due to the precipitation of fine a and w phases by aging treatment.", "set": [{"M": "Ti\u201329Nb\u201313Ta\u20134.6Zr", "F": "fatigue limit", "VoF": "700 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u201329Nb\u201313Ta\u20134.6Zr", "F": "fatigue limit", "VoF": "700 MPa", "C": "", "VoC": ""}]}, {"data_id": 215, "text": "Elastic properties of as-cast TiHfZrTaNb high entropy alloy were investigated by  ultrasound measurements, yielding G = C44 = 28 GPa and C11 = 172 GPa effective  isotropic elastic constants, allowing computation of the Young\u2019s modulus E, the bulk  modulus B and Poisson ratio n of about 78.5 GPa, 134.6 GPa and 0.402, respectively", "set": [{"M": "TiHfZrTaNb", "F": "bulk  modulus", "VoF": "134.6 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "C44", "VoF": "28 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "Young\u2019s modulus", "VoF": "78.5 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "Poisson ratio", "VoF": "0.402", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "C11", "VoF": "172 GPa", "C": "", "VoC": ""}], "pred_set": [{"M": "TiHfZrTaNb", "F": "bulk  modulus", "VoF": "134.6 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "C44", "VoF": "28 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "Young\u2019s modulus", "VoF": "78.5 GPa", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "Poisson ratio", "VoF": "0.402", "C": "", "VoC": ""}, {"M": "TiHfZrTaNb", "F": "C11", "VoF": "172 GPa", "C": "", "VoC": ""}]}, {"data_id": 189, "text": "The experimental density of the AlNbTiVZr0.5 alloy, 5.64 g cm-3, correlates well with the rule of mixture  predictions (5.63 g cm-3).", "set": [{"M": "AlNbTiVZr0.5", "F": "density", "VoF": "5.64 g cm-3", "C": "", "VoC": ""}], "pred_set": [{"M": "AlNbTiVZr0.5", "F": "density", "VoF": "5.64 g cm-3", "C": "", "VoC": ""}]}, {"data_id": 17, "text": "The tensile strength of STQ, aging 500 and aging 600 Ti-25Nb-3Fe was 780 MPa, 1070 MPa and 685 MPa respectively (Table 1).", "set": [{"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "685 MPa", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "1070 MPa", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "780 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "685 MPa", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "1070 MPa", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "tensile strength", "VoF": "780 MPa", "C": "", "VoC": ""}]}, {"data_id": 272, "text": " In the meantime, the result of tensile test showed that the CoCrFeNiNb0.155 HEA exhibited the good comprehensive mechanical properties with the yield strength and plastic strain of 321 MPa and 21.3%, respectively. ", "set": [{"M": "CoCrFeNiNb0.155", "F": "yield strength", "VoF": "321 MPa", "C": "", "VoC": ""}, {"M": "CoCrFeNiNb0.155", "F": "plastic strain", "VoF": "21.3%", "C": "", "VoC": ""}], "pred_set": [{"M": "CoCrFeNiNb0.155", "F": "yield strength", "VoF": "321 MPa", "C": "", "VoC": ""}, {"M": "CoCrFeNiNb0.155", "F": "plastic strain", "VoF": "21.3%", "C": "", "VoC": ""}]}, {"data_id": 62, "text": "A high proof stress of about 1200 MPa, high elongation of 18%, and high fatigue strength of 950 MPa indicate that aging treatment at 723 K after cold swaging is the optimal thermo-mechanical process for a TNTZ rod.", "set": [{"M": "TNTZ", "F": "proof stress", "VoF": "1200 MPa", "C": "", "VoC": ""}, {"M": "TNTZ", "F": "elongation", "VoF": "18%", "C": "", "VoC": ""}, {"M": "TNTZ", "F": "fatigue strength", "VoF": "950 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "TNTZ", "F": "proof stress", "VoF": "1200 MPa", "C": "", "VoC": ""}, {"M": "TNTZ", "F": "elongation", "VoF": "18%", "C": "", "VoC": ""}, {"M": "TNTZ", "F": "fatigue strength", "VoF": "950 MPa", "C": "", "VoC": ""}]}, {"data_id": 170, "text": "Ti\u20136Cr\u20135Mo\u20135V\u20134Al alloy is a new metastable beta alloy developed by BaoTi Group as thick-section structural materials for aerospace applications. Its design was to achieve an excellent combination of high strength and good ductility based on the multicomponent strengthening. The alloy was reported to exhibit an ultimate tensile strength around 1250 MPa and fracture toughness (KIC) levels from 73 to 94 MPa m1/2 after solution and aging treatment", "set": [{"M": "Ti\u20136Cr\u20135Mo\u20135V\u20134Al", "F": "ultimate tensile strength", "VoF": "1250 MPa", "C": "", "VoC": ""}, {"M": "Ti\u20136Cr\u20135Mo\u20135V\u20134Al", "F": "fracture toughness", "VoF": "73 to 94 MPa m1/2", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u20136Cr\u20135Mo\u20135V\u20134Al", "F": "ultimate tensile strength", "VoF": "1250 MPa", "C": "", "VoC": ""}, {"M": "Ti\u20136Cr\u20135Mo\u20135V\u20134Al", "F": "fracture toughness", "VoF": "73 to 94 MPa m1/2", "C": "", "VoC": ""}]}, {"data_id": 19, "text": "The ductility of the  STQ, aging 500 and aging 600 Ti-25Nb-3Fe was 32%, 8 % and 7 %, respectively (Table 1)", "set": [{"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "8 %", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "7 %", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "32%", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "8 %", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "7 %", "C": "", "VoC": ""}, {"M": "Ti-25Nb-3Fe", "F": "ductility", "VoF": "32%", "C": "", "VoC": ""}]}, {"data_id": 39, "text": "The HTS showed essentially constant values of tensile strength with increasing Cu content. Kikuchi et al. [9], who studied Ti\u2013Cu alloys, reported tensile strength of 650 to 700 MPa for samples produced by centrifugal casting and in magnesia-based investment molds.", "set": [{"M": "Ti\u2013Cu", "F": "tensile strength", "VoF": "650 to 700 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u2013Cu", "F": "tensile strength", "VoF": "650 to 700 MPa", "C": "", "VoC": ""}]}, {"data_id": 123, "text": "A higher value is the induction of a good balance between yield strength and Young\u2019s modulus [2,21]. The calculated elastic admissible strain of Ti513 (1.42%) is much higher than that of Ti64 ELI (0.77%), indicating a significant promise as a metallic implant.", "set": [{"M": "Ti64", "F": "elastic admissible strain", "VoF": "0.77%", "C": "", "VoC": ""}, {"M": "Ti513", "F": "elastic admissible strain", "VoF": "1.42%", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti64", "F": "elastic admissible strain", "VoF": "0.77%", "C": "", "VoC": ""}, {"M": "Ti513", "F": "elastic admissible strain", "VoF": "1.42%", "C": "", "VoC": ""}]}, {"data_id": 176, "text": "Among all the samples tested, the water quenched sample that was hot rolled and solution treated at 800 \u25e6C exhibited the lowest elastic modulus (66 \u00b1 1.2 GPa). Aging treatment of this sample increased its elastic modulus (74 \u00b1 1.7 GPa). However, this value was lower than most of the other heat treated TZN samples.", "set": [{"M": "sample", "F": "elastic modulus", "VoF": "66 \u00b1 1.2 GPa", "C": "", "VoC": ""}, {"M": "TZN", "F": "elastic modulus", "VoF": "74 \u00b1 1.7 GPa", "C": "", "VoC": ""}], "pred_set": [{"M": "sample", "F": "elastic modulus", "VoF": "66 \u00b1 1.2 GPa", "C": "", "VoC": ""}, {"M": "TZN", "F": "elastic modulus", "VoF": "74 \u00b1 1.7 GPa", "C": "", "VoC": ""}]}, {"data_id": 79, "text": "Recently, a new Ti-4Al-7Mo-3V-3Cr (Ti-4733) alloy, which contains almost the same primary  alloying elements as the Ti-5553 alloy, was designed through the theoretical d-electron method  with the aim of improving the alloy cold workability at room temperature. This alloy was  reported to exhibit high compressive strength (1400 MPa) and excellent compressive deformability (35%) in the solution treated condition.", "set": [{"M": "Ti-4Al-7Mo-3V-3Cr", "F": "compressive deformability", "VoF": "35%", "C": "", "VoC": ""}, {"M": "Ti-4Al-7Mo-3V-3Cr", "F": "compressive strength", "VoF": "1400 MPa", "C": "", "VoC": ""}, {"M": "Ti-4733", "F": "", "VoF": "", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti-4Al-7Mo-3V-3Cr", "F": "compressive deformability", "VoF": "35%", "C": "", "VoC": ""}, {"M": "Ti-4Al-7Mo-3V-3Cr", "F": "compressive strength", "VoF": "1400 MPa", "C": "", "VoC": ""}, {"M": "Ti-4733", "F": "", "VoF": "", "C": "", "VoC": ""}]}, {"data_id": 207, "text": "Increase of Cr content in the AlCrxNbTiV alloys gradually makes them stronger but  less ductile: the AlNbTiV alloy has yield strength of 1000 MPa, peak stress of 1280 MPa and  fracture strain of 5.2%, whereas corresponding values for the AlCr1.5NbTiV alloy are 1700 MPa,  1700 MPa and 0%.", "set": [{"M": "AlNbTiV", "F": "yield strength", "VoF": "1000 MPa", "C": "", "VoC": ""}, {"M": "AlNbTiV", "F": "fracture strain", "VoF": "5.2%", "C": "", "VoC": ""}, {"M": "AlNbTiV", "F": "peak stress", "VoF": "1280 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "yield strength", "VoF": "1700 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "peak stress", "VoF": "1700 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "fracture strain", "VoF": "0%", "C": "", "VoC": ""}], "pred_set": [{"M": "AlNbTiV", "F": "yield strength", "VoF": "1000 MPa", "C": "", "VoC": ""}, {"M": "AlNbTiV", "F": "fracture strain", "VoF": "5.2%", "C": "", "VoC": ""}, {"M": "AlNbTiV", "F": "peak stress", "VoF": "1280 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "yield strength", "VoF": "1700 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "peak stress", "VoF": "1700 MPa", "C": "", "VoC": ""}, {"M": "AlCr1.5NbTiV", "F": "fracture strain", "VoF": "0%", "C": "", "VoC": ""}]}, {"data_id": 198, "text": "The as-cast AlCrFe2Ni2 alloy showed a tensile yield strength of 796MPa, an ultimate strength of 1437MPa,  and an elongation of 15.7%, which was superior to most high entropy alloys and was  even comparable with the Ti-based ultrafine-grain alloy.", "set": [{"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "796MPa", "C": "", "VoC": ""}, {"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1437MPa", "C": "", "VoC": ""}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "15.7%", "C": "", "VoC": ""}], "pred_set": [{"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "796MPa", "C": "", "VoC": ""}, {"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1437MPa", "C": "", "VoC": ""}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "15.7%", "C": "", "VoC": ""}]}, {"data_id": 41, "text": "In summary, by alloying and cold rolling plus annealing treatment, a metastable b-type Ti-30Nb- 1Mo-4Sn alloy with ultralow modulus of 45 GPa and high ultimate strength of 987 MPa was prepared.", "set": [{"M": "Ti-30Nb- 1Mo-4Sn", "F": "ultimate strength", "VoF": "987 MPa", "C": "", "VoC": ""}, {"M": "Ti-30Nb- 1Mo-4Sn", "F": "modulus", "VoF": "45 GPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti-30Nb- 1Mo-4Sn", "F": "ultimate strength", "VoF": "987 MPa", "C": "", "VoC": ""}, {"M": "Ti-30Nb- 1Mo-4Sn", "F": "modulus", "VoF": "45 GPa", "C": "", "VoC": ""}]}, {"data_id": 179, "text": "The investigated alloy (Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O) corresponds to a Gum-type Ti-alloy with a microstructure formed of the \u03b2-Ti phase only. Concerning the recrystallization treatments, the most  promising variant from an application viewpoint is apparently the sample recrystallized at 800\u00b0C, for which yield strength and ultimate tensile strength are the highest (1038 MPa and 1083 MPa, respectively), the lowest elasticity modulus of 62 GPa, and the elongation is the highest (9%)", "set": [{"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "yield strength", "VoF": "1038", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "ultimate tensile strength", "VoF": "1083 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "elasticity modulus", "VoF": "62 GPa", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "elongation", "VoF": "9%", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "yield strength", "VoF": "1038", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "ultimate tensile strength", "VoF": "1083 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "elasticity modulus", "VoF": "62 GPa", "C": "", "VoC": ""}, {"M": "Ti\u201331.7Nb\u20136.21Zr\u20131.4Fe\u20130.16O", "F": "elongation", "VoF": "9%", "C": "", "VoC": ""}]}, {"data_id": 259, "text": "Refractory NbMoTaW and NbMoTaWV HEAs have compressive yield strength values of 1058 MPa and 1246 MPa at room temperature, respectively.", "set": [{"M": "NbMoTaW", "F": "compressive yield strength", "VoF": "1058 MPa", "C": "", "VoC": "room temperature"}, {"M": "NbMoTaWV", "F": "compressive yield strength", "VoF": "1246 MPa", "C": "", "VoC": "room temperature"}], "pred_set": [{"M": "NbMoTaW", "F": "compressive yield strength", "VoF": "1058 MPa", "C": "", "VoC": "room temperature"}, {"M": "NbMoTaWV", "F": "compressive yield strength", "VoF": "1246 MPa", "C": "", "VoC": "room temperature"}]}, {"data_id": 27, "text": " Despite the presence of 7.0% porosity in the PM-fabricated samples of Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O, a high strength of 682 MPa, elongation of 7.2%, and Young\u2019s modulus of 74 GPa are obtained.", "set": [{"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "elongation", "VoF": "7.2%", "C": "", "VoC": ""}, {"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "strength", "VoF": "682 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "Young\u2019s modulus", "VoF": "74 GPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "elongation", "VoF": "7.2%", "C": "", "VoC": ""}, {"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "strength", "VoF": "682 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201325Nb\u20135Mo\u20133Sn\u20132Fe\u20130.35O", "F": "Young\u2019s modulus", "VoF": "74 GPa", "C": "", "VoC": ""}]}, {"data_id": 61, "text": "The Ti\u201315Mo alloy shows low yield strength of 439 MPa, and a large elongation of 49%. On the contrary, the Ti\u201315Mo\u20131Fe alloy shows high yield strength of 837 MPa and a small elongation of 19%.", "set": [{"M": "Ti\u201315Mo", "F": "elongation", "VoF": "49%", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo", "F": "yield strength", "VoF": "439 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo\u20131Fe", "F": "yield strength", "VoF": "837 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo\u20131Fe", "F": "elongation", "VoF": "19%", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u201315Mo", "F": "elongation", "VoF": "49%", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo", "F": "yield strength", "VoF": "439 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo\u20131Fe", "F": "yield strength", "VoF": "837 MPa", "C": "", "VoC": ""}, {"M": "Ti\u201315Mo\u20131Fe", "F": "elongation", "VoF": "19%", "C": "", "VoC": ""}]}, {"data_id": 106, "text": "Surprisingly, the room temperature tensile tests showed that in the engineering  stress-strain condition, the AlCrFe2Ni2 alloy has a yield strength of 780MPa, an ultimate strength  of 1228MPa, and an elongation of 17%, respectively. These values were converted to  796MPa, 1437MPa, and 15.7% in the true stress-strain condition,", "set": [{"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1228MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "17%", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "780MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1437MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "15.7%", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "796MPa", "C": "", "VoC": "room temperature"}], "pred_set": [{"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1228MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "17%", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "780MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "ultimate strength", "VoF": "1437MPa", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "elongation", "VoF": "15.7%", "C": "", "VoC": "room temperature"}, {"M": "AlCrFe2Ni2", "F": "yield strength", "VoF": "796MPa", "C": "", "VoC": "room temperature"}]}, {"data_id": 124, "text": " Tie10Mo alloy, the addition of 2 wt% of Fe increased the yield strength to 902 MPa", "set": [{"M": "Tie10Mo", "F": "yield strength", "VoF": "902 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Tie10Mo", "F": "yield strength", "VoF": "902 MPa", "C": "", "VoC": ""}]}, {"data_id": 37, "text": ". The Ti\u20138Fe exhibits the highest yield strength (1560 MPa) and the lowest plastic strain (11%) due to the presence of high proportion of martensitic a00 phase in its microstructure.", "set": [{"M": "Ti\u20138Fe", "F": "plastic strain", "VoF": "11%", "C": "", "VoC": ""}, {"M": "Ti\u20138Fe", "F": "yield strength", "VoF": "1560 MPa", "C": "", "VoC": ""}], "pred_set": [{"M": "Ti\u20138Fe", "F": "plastic strain", "VoF": "11%", "C": "", "VoC": ""}, {"M": "Ti\u20138Fe", "F": "yield strength", "VoF": "1560 MPa", "C": "", "VoC": ""}]}, {"data_id": 246, "text": "The Mo7.5 alloy specimen annealed at 900\u00b0C  shows much higher YS (701 MPa) and UTS (1096 MPa), together with the EL of 38.3%.", "set": [{"M": "Mo7.5", "F": "YS", "VoF": "701 MPa", "C": "", "VoC": ""}, {"M": "Mo7.5", "F": "UTS", "VoF": "1096 MPa", "C": "", "VoC": ""}, {"M": "Mo7.5", "F": "EL", "VoF": "38.3%", "C": "", "VoC": ""}], "pred_set": [{"M": "Mo7.5", "F": "YS", "VoF": "701 MPa", "C": "", "VoC": ""}, {"M": "Mo7.5", "F": "UTS", "VoF": "1096 MPa", "C": "", "VoC": ""}, {"M": "Mo7.5", "F": "EL", "VoF": "38.3%", "C": "", "VoC": ""}]}, {"data_id": 253, "text": "The compressive yield stress of CoCrCuFeNi HEAs increased from 300 MPa to 613 MPa with V content increasing from 0% to 16%; the compression fracture strain decreased from 50% to 28%.", "set": [{"M": "CoCrCuFeNi", "F": "compressive yield stress", "VoF": "300 MPa", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compressive yield stress", "VoF": "613 MPa", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compression fracture strain", "VoF": "50%", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compression fracture strain", "VoF": "28%", "C": "", "VoC": ""}], "pred_set": [{"M": "CoCrCuFeNi", "F": "compressive yield stress", "VoF": "300 MPa", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compressive yield stress", "VoF": "613 MPa", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compression fracture strain", "VoF": "50%", "C": "", "VoC": ""}, {"M": "CoCrCuFeNi", "F": "compression fracture strain", "VoF": "28%", "C": "", "VoC": ""}]}]